{
    "log": {
        "level": "info",
        "timestamp": true
    },
    "inbounds": [
        {
            "type": "tun",
            "tag": "tun-in",
            "address": "172.19.0.1/30",
            "mtu": 9000,
            "auto_route": true
        }
    ],
    "outbounds": [
        {
            "tag": "proxy",
            "type": "selector",
            "outbounds": ["auto", "direct"]
        },
        {
            "tag": "auto",
            "type": "urltest",
            "outbounds": "{all}",
            "url": "http://www.gstatic.com/generate_204",
            "interval": "10m"
        },
        {
            "tag": "direct",
            "type": "direct"
        }
    ],
    "dns": {
        "servers": [
            {"tag": "local", "address": "223.5.5.5"},
            {"tag": "remote", "address": "8.8.8.8"}
        ],
        "rules": [
            {
                "clash_mode": "direct",
                "server": "local"
            }
        ],
        "final": "remote",
        "strategy": "ipv4_only"
    },
    "route": {
        "rules": [
            {
                "port": 53,
                "action": "hijack-dns"
            },
            {
                "network": "udp",
                "port": 53,
                "action": "hijack-dns"
            },
            {
                "ip_is_private": true,
                "outbound": "direct"
            },
            {
                "rule_set": ["geosite-cn", "geoip-cn"],
                "outbound": "direct"
            }
        ],
        "rule_set": [
            {
                "tag": "geosite-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/cn.srs",
                "download_detour": "direct"
            },
            {
                "tag": "geoip-cn",
                "type": "remote",
                "format": "binary",
                "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/cn.srs",
                "download_detour": "direct"
            }
        ],
        "final": "proxy"
    }
}

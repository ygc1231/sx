{
    "log": {
        "disabled": false,
        "level": "info",
        "timestamp": true
    },
    "experimental": {
        "clash_api": {
            "external_controller": "0.0.0.0:9095",
            "external_ui": "/etc/sing-box/ui",
            "secret": "",
            "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/download/v1.94.1/dist.zip",
            "external_ui_download_detour": "♻️ 自动选择",
            "default_mode": "rule"
        },
        "cache_file": {
            "enabled": true,
            "path": "/etc/sing-box/cache.db",
            "store_fakeip": false
        }
    },
    "ntp": {
        "enabled": true,
        "server": "ntp.aliyun.com",
        "server_port": 123,
        "interval": "30m"
    },
    "dns": {
        "servers": [
            {
                "tag": "dns_direct",
                "type": "udp",
                "server": "223.5.5.5",
                "detour": "🎯 全球直连"
            },
            {
                "tag": "dns_proxy",
                "type": "udp",
                "server": "8.8.8.8",
                "detour": "♻️ 自动选择"
            }
        ],
        "rules": [
            {
                "clash_mode": "direct",
                "server": "dns_direct"
            },
            {
                "clash_mode": "global",
                "server": "dns_proxy"
            },
            {
                "rule_set": "geosite-cn",
                "server": "dns_direct"
            },
            {
                "rule_set": "geosite-geolocation-!cn",
                "server": "dns_proxy"
            }
        ],
        "final": "dns_proxy",
        "strategy": "ipv4_only"
    },
    "inbounds": [
        {
            "type": "tun",
            "tag": "tun-in",
            "address": "172.18.0.1/30",
            "mtu": 9000,
            "auto_route": true,
            "auto_redirect": true,
            "strict_route": true,
            "stack": "system"
        },
        {
            "type": "mixed",
            "tag": "mixed-in",
            "listen": "127.0.0.1",
            "listen_port": 7890
        }
    ],
    "outbounds": [
        {
            "tag": "🍀 Google",
            "type": "selector",
            "outbounds": [
                "♻️ 自动选择",
                "🎯 全球直连"
            ]
        },
        {
            "tag": "🐠 漏网之鱼",
            "type": "selector",
            "outbounds": [
                "♻️ 自动选择",
                "🎯 全球直连"
            ]
        },
        {
            "tag": "♻️ 自动选择",
            "type": "urltest",
            "outbounds": [
                "{all}"
            ],
            "filter": [
                {
                    "action": "exclude",
                    "keywords": [
                        "网|址|余|期|间|效"
                    ]
                }
            ],
            "url": "http://www.gstatic.com/generate_204",
            "interval": "10m",
            "tolerance": 50
        },
        {
            "tag": "GLOBAL",
            "type": "selector",
            "outbounds": [
                "{all}"
            ]
        },
        {
            "tag": "🎯 全球直连",
            "type": "direct"
        }
    ],
    "route": {
        "auto_detect_interface": true,
        "final": "🐠 漏网之鱼",
        "default_domain_resolver": {
            "server": "dns_direct",
            "rewrite_ttl": 180,
            "client_subnet": "223.5.5.0/24"
        },
        "rules": [
            {
                "action": "sniff",
                "inbound": [
                    "tun-in",
                    "mixed-in"
                ]
            },
            {
                "protocol": "dns",
                "action": "hijack-dns"
            },
            {
                "clash_mode": "direct",
                "outbound": "🎯 全球直连"
            },
            {
                "clash_mode": "global",
                "outbound": "GLOBAL"
            },
            {
                "rule_set": [
                    "geosite-private",
                    "geoip-cn",
                    "geosite-cn"
                ],
                "ip_cidr": [
                    "10.0.0.0/24",
                    "192.168.2.0/24"
                ],
                "domain_keyword": [
                    "baidu.com",
                    "bilibili.com"
                ],
                "outbound": "🎯 全球直连"
            },
            {
                "rule_set": [
                    "geosite-chat",
                    "geosite-youtube",
                    "geosite-github",
                    "geosite-google",
                    "geoip-google",
                    "geosite-telegram",
                    "geoip-telegram",
                    "geosite-tiktok",
                    "geosite-netflix",
                    "geoip-netflix",
                    "geosite-apple",
                    "geoip-apple",
                    "geosite-onedrive",
                    "geosite-microsoft",
                    "geosite-geolocation-!cn"
                ],
                "outbound": "🍀 Google"
            }
        ],
